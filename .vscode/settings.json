{
  "vibrancy.type": "acrylic",
  "vibrancy.theme": "dark",
  "vibrancy.effect.brightness": 0.1,  
  "vibrancy.effect.opacity": 0.2,   
  "vibrancy.effect.cornerRadius": 10,
  "vibrancy.effect.useWindowControls": true,
  "vibrancy.effect.useNativeFrame": true,
  "vibrancy.effect.blur": true,
  
  "window.titleBarStyle": "native",
  "workbench.colorTheme": "SynthWave '84",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.statusBar.visible": true,
  
  "editor.fontLigatures": true,
  "editor.fontFamily": "Fira Code, Consolas, 'Courier New', monospace",
  
  "workbench.startupEditor": "none",
  "editor.renderWhitespace": "none",
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on"
}